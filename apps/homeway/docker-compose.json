{
  "services": [
    {
      "name": "homeway",
      "image": "homewayio/homeway:latest",
      "isMain": true,
      "internalPort": 11027,
      "environment": {
        "HOME_ASSISTANT_IP": "${HOMEWAY_HA_IP}",
        "HOME_ASSISTANT_ACCESS_TOKEN": "${HOMEWAY_HA_TOKEN}"
      },
      "volumes": [
        {
          "hostPath": "./data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
