{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "homeway",
      "image": "homewayio/homeway:3.0.8",
      "isMain": true,
      "internalPort": 11027,
      "environment": {
        "HOME_ASSISTANT_IP": "${HOMEWAY_HA_IP}",
        "HOME_ASSISTANT_ACCESS_TOKEN": "${HOMEWAY_HA_TOKEN}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
