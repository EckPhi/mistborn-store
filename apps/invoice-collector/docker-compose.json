{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "invoice-collector",
      "image": "ghcr.io/invoice-collector/invoice-collector:0.1",
      "isMain": true,
      "command": "npm run start",
      "environment": [
        {
          "key": "PORT",
          "value": "8080"
        },
        {
          "key": "REGISTRY_SERVER_ENDPOINT",
          "value": "https://registry.invoice-collector.com"
        },
        {
          "key": "DATABASE_URI",
          "value": "mongodb://mongodb:27017"
        },
        {
          "key": "DATABASE_MONGODB_NAME",
          "value": "prod"
        },
        {
          "key": "SECRET_MANAGER_TYPE",
          "value": "bitwarden"
        },
        {
          "key": "SECRET_MANAGER_BITWARDEN_API_URI",
          "value": "https://vault.bitwarden.eu/api"
        },
        {
          "key": "SECRET_MANAGER_BITWARDEN_IDENTITY_URI",
          "value": "https://vault.bitwarden.eu/identity"
        },
        {
          "key": "PROXY_TYPE",
          "value": "none"
        },
        {
          "key": "ENV",
          "value": "prod"
        }
      ],
      "internalPort": 8080,
      "dependsOn": {
        "mongodb": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "mongodb",
      "image": "mongo:8.0.3",
      "command": "--logpath /dev/null",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mongodb/data",
          "containerPath": "/data/db",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/mongodb/config",
          "containerPath": "/etc/mongo/",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
