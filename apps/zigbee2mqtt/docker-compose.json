{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "zigbee2mqtt",
      "image": "koenkk/zigbee2mqtt:2.14.1",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "ZIGBEE2MQTT_CONFIG_SERIAL_PORT",
          "value": "${Z2M_SERIAL_PORT}"
        },
        {
          "key": "ZIGBEE2MQTT_CONFIG_MQTT_SERVER",
          "value": "${Z2M_MQTT_SERVER}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
