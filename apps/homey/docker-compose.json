{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "homey",
      "image": "ghcr.io/athombv/homey-shs:12.10.0-rc.7",
      "isMain": true,
      "internalPort": 80,
      "networkMode": "host",
      "privileged": true,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/homey/user",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
