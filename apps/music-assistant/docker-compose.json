{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "music-assistant",
      "image": "ghcr.io/music-assistant/server:2.9.11",
      "isMain": true,
      "internalPort": 8095,
      "networkMode": "host",
      "privileged": false,
      "capAdd": [
        "SYS_ADMIN",
        "DAC_READ_SEARCH"
      ],
      "securityOpt": [
        "apparmor:unconfined"
      ],
      "environment": [
        {
          "key": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
