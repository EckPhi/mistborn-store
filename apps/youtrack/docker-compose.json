{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "permissions",
      "image": "busybox:1.38.0",
      "command": ["sh", "-c", "chown -R 13001:13001 /opt/youtrack/data /opt/youtrack/conf /opt/youtrack/logs /opt/youtrack/backups"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/opt/youtrack/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/conf",
          "containerPath": "/opt/youtrack/conf",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/logs",
          "containerPath": "/opt/youtrack/logs",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/backups",
          "containerPath": "/opt/youtrack/backups",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    },
    {
      "name": "youtrack",
      "image": "jetbrains/youtrack:2026.2.17012",
      "isMain": true,
      "internalPort": 8080,
      "dependsOn": {
        "permissions": {
          "condition": "service_completed_successfully"
        }
      },
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/opt/youtrack/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/conf",
          "containerPath": "/opt/youtrack/conf",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/logs",
          "containerPath": "/opt/youtrack/logs",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/backups",
          "containerPath": "/opt/youtrack/backups",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
