{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "home-assistant-matter-hub",
      "image": "ghcr.io/riddix/home-assistant-matter-hub:2.0.54",
      "networkMode": "host",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "HAMH_HTTP_PORT",
          "value": "8482"
        },
        {
          "key": "HAMH_STORAGE_LOCATION",
          "value": "/data"
        },
        {
          "key": "HAMH_LOG_LEVEL",
          "value": "${HAMH_LOG_LEVEL}"
        },
        {
          "key": "HAMH_HOME_ASSISTANT_URL",
          "value": "${HAMH_HOME_ASSISTANT_URL}"
        },
        {
          "key": "HAMH_HOME_ASSISTANT_ACCESS_TOKEN",
          "value": "${HAMH_HOME_ASSISTANT_ACCESS_TOKEN}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
