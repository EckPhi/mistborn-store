{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "influxdb",
      "image": "influxdb:2.9.1",
      "isMain": true,
      "internalPort": 8086,
      "environment": [
        {
          "key": "DOCKER_INFLUXDB_INIT_MODE",
          "value": "setup"
        },
        {
          "key": "DOCKER_INFLUXDB_INIT_USERNAME",
          "value": "${INFLUXDB_INIT_USERNAME}"
        },
        {
          "key": "DOCKER_INFLUXDB_INIT_PASSWORD",
          "value": "${INFLUXDB_INIT_PASSWORD}"
        },
        {
          "key": "DOCKER_INFLUXDB_INIT_ORG",
          "value": "${INFLUXDB_INIT_ORG}"
        },
        {
          "key": "DOCKER_INFLUXDB_INIT_BUCKET",
          "value": "${INFLUXDB_INIT_BUCKET}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/var/lib/influxdb2",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/etc/influxdb2",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
