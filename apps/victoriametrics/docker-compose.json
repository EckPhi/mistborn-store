{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "victoriametrics",
      "image": "victoriametrics/victoria-metrics:v1.147.0",
      "isMain": true,
      "internalPort": 8428,
      "command": [
        "-storageDataPath=/victoria-metrics-data",
        "-retentionPeriod=${VM_RETENTION_PERIOD}",
        "-httpListenAddr=:8428"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/victoria-metrics-data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
