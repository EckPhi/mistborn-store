{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "rundfunkarr",
      "image": "ghcr.io/rundfunkarr/rundfunkarr:1.4.0",
      "isMain": true,
      "internalPort": 6767,
      "environment": [
        { "key": "PUID", "value": "${UID:-1000}" },
        { "key": "PGID", "value": "${GID:-1000}" },
        { "key": "TZ", "value": "${TZ}" },
        { "key": "DATABASE_URL", "value": "file:/app/prisma/data/rundfunkarr.db" },
        { "key": "DOWNLOAD_FOLDER_PATH", "value": "/downloads" },
        { "key": "AUTH_PUBLIC_URL", "value": "${APP_PROTOCOL}://${APP_DOMAIN}" },
        { "key": "DIAGNOSTICS_ADMIN_KEY", "value": "${RUNDFUNKARR_DIAGNOSTICS_ADMIN_KEY}" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data", "containerPath": "/app/prisma/data" },
        { "hostPath": "${ROOT_FOLDER_HOST}/media/downloads", "containerPath": "/downloads" }
      ]
    }
  ]
}
