{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "matter-server",
      "image": "ghcr.io/matter-js/python-matter-server:8.1.2",
      "networkMode": "host",
      "securityOpt": [
        "apparmor=unconfined"
      ],
      "command": [
        "--storage-path",
        "/data",
        "--paa-root-cert-dir",
        "/data/credentials"
      ],
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "/run/dbus",
          "containerPath": "/run/dbus",
          "readOnly": true,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
