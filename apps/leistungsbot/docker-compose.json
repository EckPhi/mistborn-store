{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "leistungsbot",
      "image": "eckphi/leistungsbot:1.4.2",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "LEISTUNGSBOT_CONFIG_FILE",
          "value": "${LEISTUNGSBOT_CONFIG_FILE}"
        },
        {
          "key": "LEISTUNGSBOT_SQLITE__PATH",
          "value": "${LEISTUNGSBOT_SQLITE__PATH}"
        },
        {
          "key": "LEISTUNGSBOT_BOT_TOKEN",
          "value": "${LEISTUNGSBOT_BOT_TOKEN}"
        },
        {
          "key": "LEISTUNGSBOT_API_ID",
          "value": "${LEISTUNGSBOT_API_ID}"
        },
        {
          "key": "LEISTUNGSBOT_API_HASH",
          "value": "${LEISTUNGSBOT_API_HASH}"
        },
        {
          "key": "LEISTUNGSBOT_GOOGLE",
          "value": "${LEISTUNGSBOT_GOOGLE}"
        },
        {
          "key": "LEISTUNGSBOT_CHAT_ID",
          "value": "${LEISTUNGSBOT_CHAT_ID}"
        },
        {
          "key": "LEISTUNGSBOT_LEISTUNGSCHAT_ID",
          "value": "${LEISTUNGSBOT_LEISTUNGSCHAT_ID}"
        },
        {
          "key": "LEISTUNGSBOT_LEISTUNGSADMIN_ID",
          "value": "${LEISTUNGSBOT_LEISTUNGSADMIN_ID}"
        },
        {
          "key": "LEISTUNGSBOT_USERNAMES",
          "value": "${LEISTUNGSBOT_USERNAMES}"
        },
        {
          "key": "LEISTUNGSBOT_BACKUPCHAT_ID",
          "value": "${LEISTUNGSBOT_BACKUPCHAT_ID}"
        },
        {
          "key": "LEISTUNGSBOT_CALENDAR__CALENDAR_ID",
          "value": "${LEISTUNGSBOT_CALENDAR__CALENDAR_ID}"
        },
        {
          "key": "LEISTUNGSBOT_CALENDAR__CREDENTIALS",
          "value": "${LEISTUNGSBOT_CALENDAR__CREDENTIALS}"
        },
        {
          "key": "LEISTUNGSBOT_CALENDAR__TIMEZONE",
          "value": "${LEISTUNGSBOT_CALENDAR__TIMEZONE}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
