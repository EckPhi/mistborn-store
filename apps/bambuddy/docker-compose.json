{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "bambuddy",
      "image": "ghcr.io/maziggy/bambuddy:1.2.5.1",
      "isMain": true,
      "internalPort": 8000,
      "environment": [
        { "key": "TZ", "value": "${TZ}" },
        { "key": "PORT", "value": "8000" },
        { "key": "PUID", "value": "${BAMBUDDY_PUID}" },
        { "key": "PGID", "value": "${BAMBUDDY_PGID}" },
        { "key": "SLICER_API_URL", "value": "http://orca-slicer-api:3000" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${APP_DATA_DIR}/logs",
          "containerPath": "/app/logs",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    },
    {
      "name": "orca-slicer-api",
      "image": "ghcr.io/maziggy/orca-slicer-api:bambuddy-0.2.4.7",
      "environment": [
        { "key": "NODE_ENV", "value": "production" },
        { "key": "PORT", "value": "3000" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/orca",
          "containerPath": "/app/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "curl -f http://localhost:3000/health || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "startPeriod": "10s",
        "retries": 3
      }
    },
    {
      "name": "bambu-studio-api",
      "image": "ghcr.io/maziggy/bambu-studio-api:bambuddy-0.2.4.7",
      "environment": [
        { "key": "NODE_ENV", "value": "production" },
        { "key": "PORT", "value": "3000" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/bambu",
          "containerPath": "/app/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "curl -f http://localhost:3000/health || exit 1",
        "interval": "30s",
        "timeout": "5s",
        "startPeriod": "10s",
        "retries": 3
      }
    }
  ]
}
