{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "appdaemon",
      "image": "acockburn/appdaemon:4.5.13",
      "isMain": true,
      "internalPort": 5050,
      "environment": {
        "HA_URL": "${HA_URL}",
        "TOKEN": "${HA_TOKEN}",
        "DASH_URL": "http://0.0.0.0:5050"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/conf",
          "containerPath": "/conf",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
