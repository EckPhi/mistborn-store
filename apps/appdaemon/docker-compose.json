{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "appdaemon",
      "image": "acockburn/appdaemon:4.5.13",
      "isMain": true,
      "internalPort": 5050,
      "environment": [
        {
          "key": "HA_URL",
          "value": "${HA_URL}"
        },
        {
          "key": "TOKEN",
          "value": "${HA_TOKEN}"
        },
        {
          "key": "DASH_URL",
          "value": "http://0.0.0.0:5050"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/conf",
          "containerPath": "/conf",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
