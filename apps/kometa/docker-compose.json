{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "kometa",
      "image": "kometateam/quickstart:v0.10.18",
      "isMain": true,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "QS_PORT",
          "value": "7171"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/quickstart",
          "containerPath": "/config"
        }
      ],
      "internalPort": 7171
    }
  ]
}
