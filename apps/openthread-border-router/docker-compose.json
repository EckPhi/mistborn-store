{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "otbr",
      "image": "bnutzer/otbr-tcp:build-55",
      "isMain": true,
      "internalPort": 8080,
      "networkMode": "host",
      "privileged": true,
      "capAdd": [
        "NET_ADMIN"
      ],
      "devices": [
        "/dev/net/tun:/dev/net/tun"
      ],
      "environment": [
        {
          "key": "RCP_HOST",
          "value": "${OTBR_RCP_HOST}"
        },
        {
          "key": "RCP_PORT",
          "value": "${OTBR_RCP_PORT}"
        },
        {
          "key": "RCP_BAUDRATE",
          "value": "${OTBR_RCP_BAUDRATE}"
        },
        {
          "key": "OTBR_BACKBONE_IF",
          "value": "${OTBR_BACKBONE_IF}"
        },
        {
          "key": "OTBR_WEB_ENABLE",
          "value": "1"
        },
        {
          "key": "OTBR_WEB_PORT",
          "value": "8080"
        },
        {
          "key": "OTBR_LOG_LEVEL_INT",
          "value": "6"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/var/lib/thread",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
