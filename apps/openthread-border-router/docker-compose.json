{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "otbr",
      "image": "openthread/border-router:sha-b868799",
      "isMain": true,
      "internalPort": 80,
      "networkMode": "host",
      "capAdd": [
        "NET_ADMIN"
      ],
      "sysctls": {
        "net.ipv6.conf.all.disable_ipv6": 0,
        "net.ipv4.conf.all.forwarding": 1,
        "net.ipv6.conf.all.forwarding": 1
      },
      "devices": [
        "${OTBR_DEVICE_PATH}:${OTBR_DEVICE_PATH}",
        "/dev/net/tun:/dev/net/tun"
      ],
      "environment": [
        {
          "key": "OT_RCP_DEVICE",
          "value": "${OTBR_RCP_DEVICE}"
        },
        {
          "key": "OT_INFRA_IF",
          "value": "${OTBR_INFRA_IF}"
        },
        {
          "key": "OT_THREAD_IF",
          "value": "wpan0"
        },
        {
          "key": "OT_LOG_LEVEL",
          "value": "7"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
