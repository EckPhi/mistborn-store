{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "diyhue",
      "image": "diyhue/core:1057",
      "isMain": true,
      "internalPort": 80,
      "networkMode": "host",
      "environment": {
        "MAC": "${DIYHUE_MAC}",
        "TZ": "${TZ}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/opt/hue-emulator/config",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
