{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "diyhue",
      "image": "diyhue/core:1061",
      "isMain": true,
      "internalPort": 80,
      "networkMode": "host",
      "environment": [
        {
          "key": "MAC",
          "value": "${DIYHUE_MAC}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/opt/hue-emulator/config",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
