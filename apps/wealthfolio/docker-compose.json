{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "wealthfolio-permissions",
      "image": "busybox:1.38.0",
      "command": ["sh", "-c", "mkdir -p /mnt/data && chown -R 1000:1000 /mnt/data"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/mnt/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    },
    {
      "name": "wealthfolio",
      "image": "wealthfolio/wealthfolio:3.6.2",
      "isMain": true,
      "internalPort": 8088,
      "entrypoint": [
        "/bin/sh",
        "-c",
        "if [ -s /data/password.hash ]; then WF_AUTH_PASSWORD_HASH=`cat /data/password.hash`; export WF_AUTH_PASSWORD_HASH; fi; exec /usr/local/bin/wealthfolio-server"
      ],
      "dependsOn": {
        "wealthfolio-permissions": {
          "condition": "service_completed_successfully"
        }
      },
      "environment": [
        {
          "key": "WF_LISTEN_ADDR",
          "value": "0.0.0.0:8088"
        },
        {
          "key": "WF_DB_PATH",
          "value": "/data/wealthfolio.db"
        },
        {
          "key": "WF_SECRET_KEY",
          "value": "${WEALTHFOLIO_SECRET_KEY}"
        },
        {
          "key": "WF_AUTH_PASSWORD_HASH",
          "value": "${WEALTHFOLIO_PASSWORD_HASH}"
        },
        {
          "key": "WF_AUTH_REQUIRED",
          "value": "${WEALTHFOLIO_AUTH_REQUIRED}"
        },
        {
          "key": "WF_AUTH_TOKEN_TTL_MINUTES",
          "value": "${WEALTHFOLIO_TOKEN_TTL_MINUTES}"
        },
        {
          "key": "WF_CORS_ALLOW_ORIGINS",
          "value": "${WEALTHFOLIO_APP_URL}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "wget --quiet --tries=1 --spider http://127.0.0.1:8088/api/v1/healthz || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "startPeriod": "15s",
        "retries": 3
      }
    }
  ]
}
