{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "eufy-security-ws",
      "image": "bropat/eufy-security-ws:3.0.1",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "USERNAME",
          "value": "${EUFY_USERNAME}"
        },
        {
          "key": "PASSWORD",
          "value": "${EUFY_PASSWORD}"
        },
        {
          "key": "COUNTRY",
          "value": "${EUFY_COUNTRY}"
        },
        {
          "key": "LANGUAGE",
          "value": "${EUFY_LANGUAGE}"
        },
        {
          "key": "TRUSTED_DEVICE_NAME",
          "value": "${EUFY_TRUSTED_DEVICE_NAME}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    }
  ]
}
