{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "akaunting-db",
      "image": "mariadb:11.4.12",
      "environment": [
        {
          "key": "MYSQL_DATABASE",
          "value": "akaunting"
        },
        {
          "key": "MYSQL_USER",
          "value": "akaunting"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${AKAUNTING_DB_PASSWORD}"
        },
        {
          "key": "MYSQL_RANDOM_ROOT_PASSWORD",
          "value": "yes"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/db",
          "containerPath": "/var/lib/mysql",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "healthcheck.sh --connect --innodb_initialized || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "startPeriod": "30s",
        "retries": 10
      }
    },
    {
      "name": "akaunting-seed",
      "image": "akaunting/akaunting:3.1.21",
      "entrypoint": [
        "/bin/bash",
        "-c",
        "if [ ! -f /seed/artisan ]; then cp -a /var/www/html/. /seed/; fi; chown -R www-data:root /seed"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/html",
          "containerPath": "/seed",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ]
    },
    {
      "name": "akaunting",
      "image": "akaunting/akaunting:3.1.21",
      "isMain": true,
      "internalPort": 80,
      "entrypoint": [
        "/bin/bash",
        "-c",
        "if grep -qs '^APP_INSTALLED=true' /var/www/html/.env; then export AKAUNTING_SETUP=false; fi; exec /usr/local/bin/akaunting.sh --start"
      ],
      "environment": [
        {
          "key": "AKAUNTING_SETUP",
          "value": "true"
        },
        {
          "key": "APP_URL",
          "value": "${AKAUNTING_APP_URL}"
        },
        {
          "key": "LOCALE",
          "value": "${AKAUNTING_LOCALE}"
        },
        {
          "key": "DB_HOST",
          "value": "akaunting-db"
        },
        {
          "key": "DB_PORT",
          "value": "3306"
        },
        {
          "key": "DB_NAME",
          "value": "akaunting"
        },
        {
          "key": "DB_USERNAME",
          "value": "akaunting"
        },
        {
          "key": "DB_PASSWORD",
          "value": "${AKAUNTING_DB_PASSWORD}"
        },
        {
          "key": "DB_PREFIX",
          "value": "${AKAUNTING_DB_PREFIX}"
        },
        {
          "key": "COMPANY_NAME",
          "value": "${AKAUNTING_COMPANY_NAME}"
        },
        {
          "key": "COMPANY_EMAIL",
          "value": "${AKAUNTING_COMPANY_EMAIL}"
        },
        {
          "key": "ADMIN_EMAIL",
          "value": "${AKAUNTING_ADMIN_EMAIL}"
        },
        {
          "key": "ADMIN_PASSWORD",
          "value": "${AKAUNTING_ADMIN_PASSWORD}"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/html",
          "containerPath": "/var/www/html",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "dependsOn": {
        "akaunting-db": {
          "condition": "service_healthy"
        },
        "akaunting-seed": {
          "condition": "service_completed_successfully"
        }
      }
    }
  ]
}
